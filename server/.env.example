# Server Configuration
PORT=3001

# CORS - comma-separated list of additional allowed origins (optional)
# Localhost and Vercel preview deployments are allowed by default
ALLOWED_ORIGINS=http://localhost:3000

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Clerk
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key

# Test account passwords for `npm run seed:test` (dev Clerk only). Use strong
# values and keep them out of the repo; share them with testers privately.
TEST_PASSWORD_STUDENT=
TEST_PASSWORD_EDUCATOR=
TEST_PASSWORD_CLIENT=
TEST_PASSWORD_EMPLOYER=
TEST_PASSWORD_SUPER_ADMIN=
